  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>NeoXiderAgentDeck.BridgeHost.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
